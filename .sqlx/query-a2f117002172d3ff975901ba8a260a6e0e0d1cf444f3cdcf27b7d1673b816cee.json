  "db_name": "PostgreSQL",
  "query": "SELECT id, repo_id, kind, source_ref, title, summary, paths,\n                    keywords, job_id, scope, created_at, updated_at\n               FROM repo_memories\n              WHERE repo_id = $1\n                AND ($2::text IS NULL OR kind = $2)\n                AND ($3::bigint IS NULL OR id < $3)\n              ORDER BY id DESC\n              LIMIT $4",
