{
  "db_name": "PostgreSQL",
  "query": "SELECT id, slug, url, default_branch, language, mode, max_concurrent_jobs, config, created_at, tenant_id\n              FROM repos\n              WHERE lower(regexp_replace(url, '(\\.git)?/*$', '')) = $1\n                 OR right(lower(regexp_replace(url, '(\\.git)?/*$', '')), length($2) + 1) = '/' || $2\n              ORDER BY id LIMIT 2",
