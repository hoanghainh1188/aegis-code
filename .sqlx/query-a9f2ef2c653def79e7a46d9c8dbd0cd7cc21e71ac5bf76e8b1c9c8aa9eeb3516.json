  "query": "SELECT p.id, p.epic_budget_usd, epic_spent(p.id) AS \"spent!\"\n           FROM jobs p\n           WHERE p.epic_budget_usd IS NOT NULL\n             AND EXISTS (SELECT 1 FROM jobs s\n                         WHERE s.parent_job_id = p.id AND s.status = 'queued')",
