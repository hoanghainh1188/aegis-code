# /etc/aegis/aegis.env of an on-premise machine (#262,
# docs/runbook/on-premise.md); install.sh fills DOCKER_GID.
DOCKER_GID=
AEGIS_ROLE=all
# Above [worker] drain_s (600) and below the unit's TimeoutStopSec (900).
AEGIS_STOP_S=660
# This machine's own docker run arguments. Host network: the server listens
# on [api] listen and reaches PostgreSQL on this machine at 127.0.0.1.
# Secrets are files in /etc/aegis/secrets (#261), mounted read-only.
# Quoted: the file is also read by aegis-deploy (bash).
AEGIS_RUN_ARGS="--network host --volume /etc/aegis/secrets:/run/secrets:ro --volume /etc/aegis/modes:/etc/aegis/modes:ro"
# Registry of aegis-deploy, and the sandboxes it pulls with the server;
# python is also the egress proxy of the gate's fetch step.
AEGIS_REGISTRY=ghcr.io/hoanghainh1188
AEGIS_SANDBOXES="python go rust node java dotnet"
