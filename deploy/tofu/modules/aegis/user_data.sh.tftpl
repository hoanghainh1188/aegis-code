#!/bin/bash
# Khởi tạo máy aegis-server `${role}` (Amazon Linux 2023), chạy một lần khi
# tạo máy. Viết bởi OpenTofu (deploy/tofu/modules/aegis); xem
# docs/runbook/README.md.
set -euxo pipefail

dnf install -y docker
WORKSPACE=${workspace_dir}
%{ if runs_jobs ~}
DATA=/data

# Volume EBS của workspace: định dạng lần đầu, giữ nguyên khi thay máy.
DEV=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${workspace_volume}
for _ in $(seq 1 60); do [ -e "$DEV" ] && break; sleep 5; done
blkid "$DEV" || mkfs.xfs "$DEV"
mkdir -p "$DATA"
echo "$DEV $DATA xfs defaults,nofail 0 2" >> /etc/fstab
mount "$DATA"

# Image và lớp của Docker (sandbox Rust vài GB) cũng nằm trên volume này.
mkdir -p "$DATA/docker" "$DATA/workspace" /etc/docker
echo "{\"data-root\": \"$DATA/docker\"}" > /etc/docker/daemon.json
systemctl enable --now docker

# Đường dẫn workspace trùng trong container và trên máy: gate đưa đường
# dẫn này cho daemon Docker khi mount /work vào sandbox.
mkdir -p "$WORKSPACE"
echo "$DATA/workspace $WORKSPACE none bind,nofail 0 0" >> /etc/fstab
mount "$WORKSPACE"
%{ else ~}
# Máy API (#323): Docker chỉ chạy container aegis; không có proxy Docker
# nên aegis không điều khiển được daemon. Workspace trên đĩa gốc, chỉ cho
# bản clone mà trang admin kiểm tra (#330); worker tự clone trên máy nó.
systemctl enable --now docker
mkdir -p "$WORKSPACE"
%{ endif ~}
chown ${aegis_uid}:${aegis_uid} "$WORKSPACE"
chmod 0750 "$WORKSPACE"

mkdir -p /etc/aegis
cat > /etc/aegis/server.toml <<'TOML'
${server_toml}
TOML
# Tham số riêng của máy cho unit chung deploy/systemd/aegis.service (#262).
%{ if runs_jobs ~}
# Group của /var/run/docker.sock: chỉ aegis-docker-proxy (#321) có nó; ai có
# group này là root của máy (docs/runbook, "Worker và Docker"). aegis-server
# (uid ${aegis_uid}) đi qua socket của proxy.
%{ else ~}
# Không có aegis-docker-proxy trên máy API: DOCKER_GID không dùng tới.
%{ endif ~}
# --network host: đọc role của máy qua IMDS (hop limit 1 chặn container
# khác). AEGIS_STOP_S lớn hơn worker.drain_s để job đang chạy kịp xong.
cat > /etc/aegis/aegis.env <<ENV
DOCKER_GID=$(getent group docker | cut -d: -f3)
AEGIS_DOCKER_PROXY_ARGS=""
AEGIS_ROLE=${role}
AEGIS_STOP_S=${stop_timeout_s}
AEGIS_RUN_ARGS="--network host --log-driver awslogs --log-opt awslogs-region=${region} --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=${role}-$(hostname)"
ENV

cat > /usr/local/bin/aegis-deploy <<'DEPLOY'
#!/bin/bash
# aegis-deploy [tag]: chạy image aegis-server `${role}` theo tag (mặc định:
# SSM parameter ${image_tag_param}), %{ if runs_jobs }kéo image sandbox cùng tag, %{ endif }chờ
# health. Rollback = chạy lại với tag trước.
set -euo pipefail
tag="$${1:-$(aws ssm get-parameter --region ${region} --name ${image_tag_param} --query Parameter.Value --output text)}"
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}
docker pull "${image_repository}:$tag"
%{ if runs_jobs ~}
for p in ${sandbox_profiles}; do
  docker pull "${registry}/aegis-sandbox-$p:$tag"
  docker tag "${registry}/aegis-sandbox-$p:$tag" "aegis-sandbox-$p"
done
%{ endif ~}
echo "AEGIS_IMAGE=${image_repository}:$tag" > /etc/aegis/image.env
%{ if runs_jobs ~}
# Job đang chạy kịp xong: aegis drain trong AEGIS_STOP_S (worker.drain_s).
systemctl restart aegis-docker-proxy aegis
%{ else ~}
systemctl restart aegis
%{ endif ~}
%{ if role == "worker" ~}
# Worker không có API: /metrics trả lời ngay khi nối được DB, trước khi
# worker nạp các mode (có thể lỗi). Nên sau đó chờ thêm và đòi unit không
# khởi động lại lần nào (Restart=always che mất lỗi).
health=http://127.0.0.1:9464/metrics
settle_s=30
%{ else ~}
# `all` mở API sau khi worker đã nạp các mode: health đủ.
health=http://127.0.0.1:8080/api/v1/health
settle_s=0
%{ endif ~}
restarts() { systemctl show aegis --property NRestarts --value; }
before=$(restarts)
for _ in $(seq 1 60); do
  if curl -fsS "$health" >/dev/null; then
    sleep "$settle_s"
    if systemctl is-active --quiet aegis && [ "$(restarts)" = "$before" ] && curl -fsS "$health" >/dev/null; then
      echo "aegis-server ${role} $tag healthy"
      exit 0
    fi
    echo "aegis-server ${role} $tag restarted after starting" >&2
    break
  fi
  sleep 5
done
echo "aegis-server ${role} $tag not healthy (5 min at most)" >&2
journalctl -u aegis --no-pager -n 50 >&2
exit 1
DEPLOY
chmod 0755 /usr/local/bin/aegis-deploy

cat > /etc/systemd/system/aegis.service <<'UNIT'
${aegis_unit}
UNIT
%{ if runs_jobs ~}
cat > /etc/systemd/system/aegis-docker-proxy.service <<'UNIT'
${docker_proxy_unit}
UNIT
mkdir -p /etc/systemd/system/aegis.service.d
cat > /etc/systemd/system/aegis.service.d/jobs.conf <<'UNIT'
${jobs_dropin}
UNIT
systemctl daemon-reload
systemctl enable aegis-docker-proxy aegis
%{ else ~}
systemctl daemon-reload
systemctl enable aegis
%{ endif ~}

# Lần đầu (tag "bootstrap") chưa có image: chờ workflow deploy.
if [ "$(aws ssm get-parameter --region ${region} --name ${image_tag_param} --query Parameter.Value --output text)" != "bootstrap" ]; then
  /usr/local/bin/aegis-deploy
fi
